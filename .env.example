# Backend Configuration
# ------------------------------------------------------------------
# EN DESARROLLO: los valores de abajo funcionan tal cual.
#
# EN PRODUCCIÓN, la app se niega a arrancar (ValidationError) si:
#   - falta SECRET_KEY
#   - ENVIRONMENT=production y DEBUG=true
#   - ENVIRONMENT=production y CORS_ORIGINS sigue en localhost o es "*"
# Ver PRODUCTION_READINESS.md para la checklist completa antes de desplegar.
# ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción: un valor distinto por entorno, nunca el mismo que en .env.example.
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./restomind.db
DATABASE_ECHO=true

# CORS — en producción, reemplazar por el dominio real del frontend, ej:
# CORS_ORIGINS=["https://app.turestaurante.com"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Claude API (para futuro)
ANTHROPIC_API_KEY=your-api-key-here

# Facturación electrónica SUNAT
# ------------------------------------------------------------------
# emisor_facturacion=sunat_cloud (default): RestoMind firma y envía el
# comprobante a SUNAT desde el servidor, vía el contenedor sunat-service.
# No necesita ninguna PC con Windows en el restaurante.
#
# El emisor "sfs_local" (Facturador de escritorio + archivos planos +
# agente de PowerShell) se eliminó. Si tu .env todavía lo tiene, la app lo
# normaliza a sunat_cloud sola — no hace falta tocar nada para arrancar.
EMISOR_FACTURACION=sunat_cloud
# Carpeta de certificados, un subdirectorio por restaurante. Es el mismo
# volumen que monta sunat-service (ver docker-compose.yml).
CERTS_DIR=certs

# emisor_facturacion=facturacion_pe (de pago, S/0.20/boleta): API externa.
# Alternativa para quien prefiera no administrar su propio certificado.
FACTURACION_PE_API_KEY=
FACTURACION_PE_URL=https://api.facturacion.pe/v1

# Server
HOST=0.0.0.0
PORT=8000

# --- Emisor "sunat_cloud": firmar y enviar a SUNAT desde el servidor ---
# Para el restaurante SIN PC con Windows (solo tablets/celulares). Exige
# certificado digital. Guía completa: docs/SUNAT_SETUP.md
#
# Ya viene activado por defecto. Levantar el contenedor con:
#   docker compose up -d --build
#
# El token lo comparten RestoMind y el contenedor. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SUNAT_SERVICE_URL=http://127.0.0.1:8100
SUNAT_SERVICE_TOKEN=
# "beta" = ambiente de pruebas de SUNAT, no emite comprobantes reales.
# Pasar a "prod" recien cuando el circuito completo este probado.
SUNAT_MODE=beta

# --- Consulta de DNI (opcional, de pago) ---
# El Padrón Reducido de SUNAT solo tiene RUC: un DNI no se puede resolver
# ahí. Sin esto configurado, un DNI desconocido simplemente pide que el
# cajero escriba el nombre — nunca falla un cobro por esto.
#
# El resultado se guarda en clientes_frecuentes (por restaurante), así que
# la segunda visita de la misma persona sale gratis y al instante.
DNI_API_URL=
DNI_API_TOKEN=
