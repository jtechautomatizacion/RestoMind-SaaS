# Backend Configuration
# ------------------------------------------------------------------
# EN DESARROLLO: los valores de abajo funcionan tal cual.
#
# EN PRODUCCIÓN, la app se niega a arrancar (ValidationError) si:
#   - falta SECRET_KEY
#   - ENVIRONMENT=production y DEBUG=true
#   - ENVIRONMENT=production y CORS_ORIGINS sigue en localhost o es "*"
# Ver PRODUCTION_READINESS.md para la checklist completa antes de desplegar.
# ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción: un valor distinto por entorno, nunca el mismo que en .env.example.
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./restomind.db
DATABASE_ECHO=true

# CORS — en producción, reemplazar por el dominio real del frontend, ej:
# CORS_ORIGINS=["https://app.turestaurante.com"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Claude API (para futuro)
ANTHROPIC_API_KEY=your-api-key-here

# Facturación electrónica SUNAT
# ------------------------------------------------------------------
# emisor_facturacion=sunat_cloud (default): RestoMind firma y envía el
# comprobante a SUNAT desde el servidor, vía el contenedor sunat-service.
# No necesita ninguna PC con Windows en el restaurante.
#
# El emisor "sfs_local" (Facturador de escritorio + archivos planos +
# agente de PowerShell) se eliminó. Si tu .env todavía lo tiene, la app lo
# normaliza a sunat_cloud sola — no hace falta tocar nada para arrancar.
EMISOR_FACTURACION=sunat_cloud
# Carpeta de certificados, un subdirectorio por restaurante. Es el mismo
# volumen que monta sunat-service (ver docker-compose.yml).
CERTS_DIR=certs

# emisor_facturacion=facturacion_pe (de pago, S/0.20/boleta): API externa.
# Alternativa para quien prefiera no administrar su propio certificado.
FACTURACION_PE_API_KEY=
FACTURACION_PE_URL=https://api.facturacion.pe/v1

# Server
HOST=0.0.0.0
PORT=8000

# --- Emisor "sunat_cloud": firmar y enviar a SUNAT desde el servidor ---
# Para el restaurante SIN PC con Windows (solo tablets/celulares). Exige
# certificado digital. Guía completa: docs/SUNAT_SETUP.md
#
# Ya viene activado por defecto. Levantar el contenedor con:
#   docker compose up -d --build
#
# El token lo comparten RestoMind y el contenedor. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SUNAT_SERVICE_URL=http://127.0.0.1:8100
SUNAT_SERVICE_TOKEN=
#
# SUNAT_MODE y SUNAT_SOAP_TIMEOUT NO van en este archivo. Las lee el
# CONTENEDOR (sunat-service/app.py), no backend/config.py — y Settings
# rechaza toda variable que no declara, así que una sola de estas líneas acá
# deja la app sin arrancar:
#
#     sunat_mode  Extra inputs are not permitted [type=extra_forbidden]
#
# docker-compose.yml ya las defaultea (beta / 30s), así que en desarrollo no
# hay que declararlas en ningún lado. Para pasar a producción:
#
#     SUNAT_MODE=prod docker compose up -d
#
# o un archivo aparte con --env-file (ver deploy/RUNBOOK.md).

# --- Correo de bienvenida (SMTP) ---
# Sin SMTP_USER y SMTP_PASSWORD no se envía NADA, y el alta del restaurante
# igual funciona: el correo es un extra, nunca un requisito. Pero el fallo
# es silencioso, así que estas líneas van acá aunque queden vacías — para
# que se vea que existen en vez de descubrirlo cuando un cliente avisa que
# nunca le llegó el acceso.
#
# PRIMERO: ¿DÓNDE VIVE LA CASILLA? No se deduce de la dirección.
# ---------------------------------------------------------------------
# Esto costó un rato de producción: poner una dirección del dominio propio
# (facturacion@tuempresa.com) apuntando a smtp.gmail.com devuelve
#
#     535 5.7.8 Username and Password not accepted
#
# ...que parece "contraseña mal escrita" y no lo es: Gmail rechaza
# autenticar un usuario que no le pertenece. La dirección NO dice dónde
# está el buzón. Lo dice el registro MX del dominio:
#
#     dig +short MX tuempresa.com
#
#   -> apunta a google.com          : es Gmail / Google Workspace
#        SMTP_HOST=smtp.gmail.com
#        y la clave es una "Contraseña de aplicación" de 16 caracteres
#        (https://myaccount.google.com/apppasswords, con verificación en
#        2 pasos activada), NUNCA la contraseña de la cuenta.
#
#   -> apunta al propio dominio     : el correo está en tu hosting/cPanel
#        SMTP_HOST=mail.tuempresa.com
#        y la clave es la de la casilla, la que pusiste al crearla en
#        cPanel > Cuentas de correo. Una contraseña de aplicación de Gmail
#        no sirve acá: son sistemas distintos.
#
# Verificá la combinación ANTES de dar de alta un restaurante de verdad:
#
#     python -c "import smtplib,ssl; s=smtplib.SMTP('TU_HOST',587,timeout=15); \
#                s.starttls(context=ssl.create_default_context()); \
#                s.login('TU_USUARIO','TU_CLAVE'); print('OK'); s.quit()"
#
# Recordá que el correo lleva el USUARIO de acceso, nunca la contraseña
# (ver backend/email.py, regla 1): si el mensaje rebota, el aviso de rebote
# incluye una copia del original.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=RestoMind

# A qué dirección apunta la app en los correos que salen del servidor
# (bienvenida, recuperación). Tiene un default de localhost para que el
# entorno de desarrollo arranque sin configurar nada — y por eso mismo, EN
# PRODUCCIÓN HAY QUE PONERLA: sin esto los correos le mandan al cliente un
# enlace a "localhost", que en su teléfono no abre nada.
APP_URL=http://localhost:8000

# Enlace de descarga del APK, para el correo de bienvenida. Vacío = el
# correo no muestra esa sección (mejor que un botón a una carpeta vacía).
# Va acá y no en el código porque cambia por motivos ajenos al programa:
# una versión nueva, otra carpeta, o el día que pase a la Play Store.
APK_URL=

# --- Consulta de DNI (opcional, de pago) ---
# El Padrón Reducido de SUNAT solo tiene RUC: un DNI no se puede resolver
# ahí. Sin esto configurado, un DNI desconocido simplemente pide que el
# cajero escriba el nombre — nunca falla un cobro por esto.
#
# El resultado se guarda en clientes_frecuentes (por restaurante), así que
# la segunda visita de la misma persona sale gratis y al instante.
DNI_API_URL=
DNI_API_TOKEN=
