<?xml version="1.0" encoding="utf-8"?>
<!-- Mismo trazo de mesa que el ícono de la PWA (frontend/manifest.json), para
     que el ícono del celular y el de la app instalada desde el navegador sean
     el mismo dibujo.

     El lienzo del ícono adaptativo es 108x108 pero solo los 72x72 centrales
     están garantizados: el resto lo puede recortar el launcher según la forma
     que use cada fabricante. Por eso el dibujo de 64x64 se centra con un
     translate de 22 y se escala a 0.78, que lo deja dentro de esa zona. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="29"
        android:translateY="29"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <path android:pathData="M20,28 H44" android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
