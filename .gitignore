venv/
__pycache__/
*.pyc
.env
# Backups/variantes del .env: mismos secretos, mismo riesgo. El patrón
# ".env" solo, sin esto, no cubre ".env.bak", ".env.local", etc.
.env.*
!.env.example
instance/
restomind.db
# Cualquier copia de la BD, se llame como se llame. El patrón anterior era
# solo "restomind.db.backup-*" y por eso se coló un "restomind.db.bak-..."
# al repo: una base REAL, con sus clientes, comprobantes y hashes de
# contraseña. Un glob que cubre un solo nombre de backup es un glob que
# tarde o temprano no cubre el que alguien escribió a mano.
restomind.db.*
*.db.bak
*.db.bak-*
*.db.backup-*
# Con modo WAL activado (backend/database.py) SQLite mantiene estos dos
# archivos auxiliares junto al .db mientras el proceso está corriendo —
# runtime, no algo para versionar, igual que el .db mismo.
restomind.db-shm
restomind.db-wal
# Logs del servidor de desarrollo (uvicorn escribe stdout y stderr por
# separado). Son artefactos de ejecución local, no del repo — y un traceback
# puede llevar rutas o datos de la BD real.
*.log

# Fotos subidas por el usuario: son datos de instancia, no del repo.
# El endpoint las crea al vuelo (backend/routes/platos.py); solo se
# versiona la carpeta vacía (.gitkeep).
frontend/assets/platos/*
!frontend/assets/platos/.gitkeep

# ============ CERTIFICADOS SUNAT — NUNCA COMMITEAR ============
# Un .pfx con su clave permite emitir comprobantes a nombre del restaurante:
# quien lo obtiene puede facturar por él. sol.txt son las credenciales con
# las que el negocio se identifica ante SUNAT.
# Si alguna vez se commitea uno por error, no alcanza con borrarlo en el
# commit siguiente: queda en el historial. Hay que revocarlo y emitir otro.
certs/
*.pfx
*.p12
sol.txt
clave.txt

# ============ PADRÓN SUNAT — NUNCA COMMITEAR ============
# ~1.6 GB con los nombres de ~19 millones de contribuyentes, muchos de ellos
# personas naturales (Ley N° 29733). Se reconstruye con:
#   python -m backend.scripts.cargar_padron_sunat
# Subirlo a un repositorio sería republicar datos personales, además de
# hacer inmanejable el historial de git.
data/
*.db.construyendo
padron_reducido_ruc.zip
dist-apk/
node_modules/
apk/

# El APK que se deja en la raíz para instalar en el celular de pruebas. Se
# regenera con `npm run apk`, pesa 4 MB, y cambia en cada compilación: es
# justo lo que no debe entrar al historial.
*.apk
