venv/
__pycache__/
*.pyc
.env
# Backups/variantes del .env: mismos secretos, mismo riesgo. El patrón
# ".env" solo, sin esto, no cubre ".env.bak", ".env.local", etc.
.env.*
!.env.example
instance/
restomind.db
restomind.db.backup-*
# Con modo WAL activado (backend/database.py) SQLite mantiene estos dos
# archivos auxiliares junto al .db mientras el proceso está corriendo —
# runtime, no algo para versionar, igual que el .db mismo.
restomind.db-shm
restomind.db-wal
# Logs del servidor de desarrollo (uvicorn escribe stdout y stderr por
# separado). Son artefactos de ejecución local, no del repo — y un traceback
# puede llevar rutas o datos de la BD real.
*.log

# Archivos que el agente de la PC del restaurante genera o completa.
# config.json lleva el TOKEN de ese local en claro; descargados.txt es el
# registro de qué comprobantes ya se entregaron, propio de esa máquina.
# Solo se versiona config.example.json, con placeholders.
agente/config.json
agente/descargados.txt

# Fotos subidas por el usuario: son datos de instancia, no del repo.
# El endpoint las crea al vuelo (backend/routes/platos.py); solo se
# versiona la carpeta vacía (.gitkeep).
frontend/assets/platos/*
!frontend/assets/platos/.gitkeep
