{
  "name": "restomind",
  "version": "1.0.0",
  "private": true,
  "description": "RestoMind POS - envoltorio Capacitor de la PWA",
  "scripts": {
    "sync": "node tools/preparar-apk.mjs && cap sync android",
    "abrir": "cap open android",
    "probar-termica": "node tools/probar-termica.mjs",
    "preparar-apk": "node tools/preparar-apk.mjs",
    "integrar-android": "node tools/integrar-android.mjs",
    "apk": "node tools/preparar-apk.mjs && cap sync android && node tools/integrar-android.mjs && node tools/compilar.mjs produccion",
    "apk:testing": "node tools/preparar-apk.mjs local && cap sync android && node tools/integrar-android.mjs && node tools/compilar.mjs testing",
    "servir-testing": "node tools/servir-testing.mjs",
    "clonar-a-pruebas": ".venv/Scripts/python.exe tools/clonar-a-pruebas.py",
    "iconos": ".venv/Scripts/python.exe tools/generar-iconos.py",
    "version": "node tools/subir-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
