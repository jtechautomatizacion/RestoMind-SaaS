[Unit]
Description=RestoMind API (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=restomind
Group=restomind
WorkingDirectory=/home/restomind/app
EnvironmentFile=/home/restomind/app/.env
# Un solo worker, sin --workers: backend/utils/rate_limit.py guarda los
# intentos fallidos de login en memoria del proceso. Con más de un worker,
# cada uno lleva su propio contador y el límite de "5 fallos" se vuelve
# "5 x cantidad de workers" — pasar a varios workers requiere antes migrar
# ese contador a algo compartido (Redis). Escucha solo en loopback: Nginx
# es la única puerta pública (ver deploy/nginx.conf.template).
ExecStart=/home/restomind/app/venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Endurecimiento estándar de systemd — no le da a este proceso más de lo
# que necesita (no puede escalar privilegios ni tocar el resto del sistema
# de archivos salvo lo que declara acá).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/restomind/app

# ProtectHome debe quedar EN false, y no es un descuido.
#
# `ProtectHome=true` monta /home vacío para el servicio. Como esta app vive
# en /home/restomind/app, systemd deja de ver su propio ExecStart y el
# arranque muere con:
#
#     restomind.service: Main process exited, code=exited, status=203/EXEC
#
# 203/EXEC no dice "no puedo ver el archivo", así que el síntoma parece un
# binario roto o un venv mal armado — y el binario corre perfecto a mano,
# lo que manda a buscar el problema al lugar equivocado. Costó un rato de
# despliegue real encontrarlo.
#
# `ReadWritePaths=` NO alcanza para destaparlo: la ruta del ExecStart se
# resuelve dentro del namespace ya con /home enmascarado.
#
# Lo que ProtectHome protege igual sigue cubierto: el servicio corre como
# 'restomind', un usuario sin privilegios que por permisos de archivo no
# puede leer el home de nadie más. La alternativa "limpia" sería mover la
# app a /opt o /srv, pero eso cambia rutas en setup_vps.sh, deploy.sh,
# nginx.conf.template y el RUNBOOK entero — más superficie de error que
# la que resuelve.
ProtectHome=false

[Install]
WantedBy=multi-user.target
